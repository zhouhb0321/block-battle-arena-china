# Copy to .env for local development. Never commit real secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Product analytics (PostHog). Leave empty to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (Sentry DSN). Leave empty to disable.
VITE_SENTRY_DSN=
VITE_APP_VERSION=dev

# Payments (Paddle + Stripe). Server-side secrets belong in Supabase Edge Function secrets,
# not in Vite env vars.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
VITE_STRIPE_PRICE_STARTER=
